# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (leave empty to allow all in development)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nova_ecommerce

# Auth — use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=your_super_secret_jwt_key
ADMIN_SECRET=another_long_random_secret

# First admin account, created when the admins table is empty. Choose your own: there is no
# built-in default, and without these no admin account is created.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to false to skip the demo order history on a fresh database
SEED_DEMO_ORDERS=true

# Where uploaded product photos are stored.
# - "local" saves them in backend/uploads/products/ (ephemeral on free cloud hosts like Render).
# - "cloudinary" (Recommended for cloud/production) uploads to Cloudinary CDN (25GB free):
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (order confirmations, status updates, password-reset codes, contact replies).
# Note: Render Free Tier strictly blocks outbound SMTP ports 25, 465, and 587.
# For 100% reliable free email delivery on Render Free tier, provide a BREVO_API_KEY or RESEND_API_KEY:
# - Brevo (Free 300 emails/day over HTTPS port 443):
#   BREVO_API_KEY=xkeysib-...
#   BREVO_SENDER_EMAIL=you@gmail.com
# - Resend (Free 3,000 emails/month over HTTPS port 443):
#   RESEND_API_KEY=re_...
#
# Alternatively, use standard SMTP (works locally, or on paid cloud hosts where SMTP ports are open):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to customers.
MAIL_FROM="NOVA <no-reply@novastore.com>"
# Optional: replies go here (defaults to support@novastore.com)
SUPPORT_EMAIL=
# Optional: storefront address used in email links (defaults to the first CLIENT_URL)
STORE_URL=

# Card payments with Stripe Checkout (test mode). Get the keys at https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY the card option is hidden and checkout offers cash on delivery only.
# Only sk_test_ keys are accepted unless NODE_ENV=production and STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (whsec_...). Locally: `stripe listen --forward-to localhost:5000/api/payments/webhook`
# prints one. Optional in development: payments are also confirmed when the shopper returns to the store.
STRIPE_WEBHOOK_SECRET=

# Google OAuth Login (Google Cloud Console OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=
