# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (leave empty to allow all in development)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nova_ecommerce

# Auth — use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=your_super_secret_jwt_key
ADMIN_SECRET=another_long_random_secret

# First admin account (created automatically when the admins table is empty)
ADMIN_USERNAME=nova_admin
ADMIN_PASSWORD=Nova@Admin#2024

# Set to false to skip the demo order history on a fresh database
SEED_DEMO_ORDERS=true

# Where uploaded product photos are stored. "local" saves them in backend/uploads/products/.
STORAGE_DRIVER=local

# Email (order confirmations, status updates, password-reset codes, contact replies).
# Leave SMTP_HOST empty in development: emails are printed to the API terminal and their
# HTML is saved to backend/.email-previews/. Examples:
#   Gmail:  SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-character app password>
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<Brevo SMTP login> SMTP_PASS=<SMTP key>
#   Resend: SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to customers. Gmail only allows your own address; Brevo/Resend need a verified domain.
MAIL_FROM="NOVA <no-reply@yourdomain.com>"
# Optional: replies go here (defaults to support@novastore.com)
SUPPORT_EMAIL=
# Optional: storefront address used in email links (defaults to the first CLIENT_URL)
STORE_URL=

# Card payments with Stripe Checkout (test mode). Get the keys at https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY the card option is hidden and checkout offers cash on delivery only.
# Only sk_test_ keys are accepted unless NODE_ENV=production and STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (whsec_...). Locally: `stripe listen --forward-to localhost:5000/api/payments/webhook`
# prints one. Optional in development: payments are also confirmed when the shopper returns to the store.
STRIPE_WEBHOOK_SECRET=

# Google OAuth Login (Google Cloud Console OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=
